{
  "extends": "cifar10_upstream.json",
  "name": "cifar10_ddpmpp_vp",
  "data": {
    "centered": true
  },
  "training": {
    "sde": "vpsde",
    "reduce_mean": true
  },
  "model": {
    "scale_by_sigma": false,
    "ema_rate": 0.9999,
    "fir": false,
    "progressive_input": "none",
    "embedding_type": "positional"
  },
  "sampling": {
    "predictor": "euler_maruyama",
    "corrector": "none",
    "eps": 0.001
  },
  "provenance": {
    "recipe": "configs/vp/cifar10_ddpmpp_continuous.py + default_cifar10_configs"
  }
}
